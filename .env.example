# Upstash Redis (provisioned via Vercel Marketplace -> Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin authentication
# Generate hash with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Random 32+ char secret used to sign HTTP-only admin session cookies
SESSION_SECRET=
