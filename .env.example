# Upstash Redis (supports either UPSTASH_REDIS_REST_* or Vercel Marketplace KV_REST_API_*)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Admin authentication
# Generate hash with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Random 32+ char secret used to sign HTTP-only admin session cookies
SESSION_SECRET=
